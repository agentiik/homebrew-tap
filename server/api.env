# The settings of agentiik-api serve, for a server on this Mac alone: https://agentiik.github.io/docs/#configuration
#
# agentiik-server reads this file with /bin/sh (set -a, then .), so a value holding a space or a & is quoted.
# Each program reads its own file, as each reads its own rows on the site: the controller refuses AGK_MASTER_KEY_FILE,
# and has no listener for AGK_TLS_CERT_FILE, so what both read is written in both files.
# Every AGK_*_FILE names a file agentiik-setup writes, readable by its owner alone.
# Homebrew keeps this file across upgrades, and writes a newer default beside it as api.env.default.

# Shared with the controller: controller.env says the same.
AGK_DATABASE_URL="postgres://agentiik@/agentiik?host=/tmp"
AGK_DATABASE_PASSWORD_FILE="@HOMEBREW_PREFIX@/etc/agentiik/secrets/database-password"
AGK_BUS_URL="tls://localhost:4222"
AGK_BUS_CREDENTIALS_FILE="@HOMEBREW_PREFIX@/var/lib/agentiik/bus/control-plane.creds"
AGK_OBJECTS_DIR="@HOMEBREW_PREFIX@/var/lib/agentiik/objects"

# The API's alone.
# Loopback only, since nothing but this Mac reaches it. A runner on another host needs an address it reaches,
# here and in AGK_BUS_URL, with a certificate naming it.
AGK_LISTEN="127.0.0.1:8443"
AGK_PUBLIC_URL="https://localhost:8443"
AGK_TLS_CERT_FILE="@HOMEBREW_PREFIX@/etc/agentiik/tls/server.pem"
AGK_TLS_KEY_FILE="@HOMEBREW_PREFIX@/etc/agentiik/tls/server.key"
AGK_BUS_ACCOUNT_SEED_FILE="@HOMEBREW_PREFIX@/var/lib/agentiik/bus/account.seed"
AGK_PRESIGN_KEY_FILE="@HOMEBREW_PREFIX@/etc/agentiik/secrets/presign-key"
AGK_MASTER_KEY_FILE="@HOMEBREW_PREFIX@/etc/agentiik/secrets/master-key"
AGK_OPERATOR_TOKEN_FILE="@HOMEBREW_PREFIX@/etc/agentiik/secrets/operator-token.sha256"
